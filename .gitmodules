[submodule "sdk"]
	path = sdk
	url = https://github.com/Ircam-RnD/pipo-sdk.git
	branch = develop
[submodule "modules/bayesfilter"]
	path = modules/bayesfilter
	url = https://github.com/Ircam-RnD/bayesfilter.git
[submodule "modules/wavelet"]
	path = modules/wavelet
	url = https://github.com/Ircam-RnD/wavelet.git
[submodule "modules/rta"]
	path = modules/rta
	url = https://github.com/Ircam-RnD/rta-lib.git
[submodule "modules/javascript-engine/jerryscript"]
	path = modules/javascript-engine/jerryscript
	url = https://github.com/jerryscript-project/jerryscript.git

[submodule "modules/flucoma-core"]
	path = modules/flucoma-core
	url = https://github.com/flucoma/flucoma-core.git
	branch = production
	
[submodule "modules/polyspring"]
	path = modules/polyspring
	url = https://github.com/ircam-ismm/polyspring.git
[submodule "modules/fluidsynth-for-max"]
	path = modules/fluidsynth-for-max
	url = git@forge-2.ircam.fr:ismm/fluidsynth-for-max.git
